# Volta (sm_70) build toolchain for the `v100` target.
# sm_70 compiles with CUDA >=12.8 and <13 (CUDA 13 removed Volta), so this
# stays on 12.9.1 while upstream's Dockerfile tracks CUDA 13.x for sm_120a/121a.
# Toolchain-only image: mount the source tree and configure/build inside it.
FROM nvidia/cuda:12.9.1-devel-ubuntu24.04

ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        build-essential \
        cmake \
        ninja-build \
        pkg-config \
        git \
        ca-certificates \
        python3 \
        python3-dev \
        libavcodec-dev \
        libavformat-dev \
        libavutil-dev \
        libswscale-dev \
        libcurl4-openssl-dev \
        libjpeg-turbo8-dev \
        libhwloc-dev \
        liburing-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src

# Example:
#   podman build -t ninfer-build:cu129 -f Containerfile.volta .
#   podman run --rm --security-opt label=disable \
#     -v <tree>:/src ninfer-build:cu129 \
#     cmake --preset v100-release
